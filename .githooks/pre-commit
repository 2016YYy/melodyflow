#!/bin/sh
# MelodyFlow 提交前敏感信息扫描（gitleaks）
# 启用方式：git config core.hooksPath .githooks
# 跳过（不推荐）：git commit --no-verify

find_gitleaks() {
  # 1) PATH
  if command -v gitleaks >/dev/null 2>&1; then
    command -v gitleaks
    return 0
  fi
  # 2) 环境变量
  if [ -n "$GITLEAKS_BIN" ] && [ -x "$GITLEAKS_BIN" ]; then
    echo "$GITLEAKS_BIN"
    return 0
  fi
  # 3) 工作区 tools 目录（与仓库同级）
  candidate="$(dirname "$0")/../../tools/gitleaks/gitleaks.exe"
  if [ -f "$candidate" ]; then
    echo "$candidate"
    return 0
  fi
  candidate="$(dirname "$0")/../tools/gitleaks/gitleaks.exe"
  if [ -f "$candidate" ]; then
    echo "$candidate"
    return 0
  fi
  return 1
}

GITLEAKS="$(find_gitleaks)"
if [ -z "$GITLEAKS" ]; then
  echo "[secret-scan] 未找到 gitleaks，跳过本次扫描。" >&2
  echo "[secret-scan] 安装请运行：pwsh -File scripts/setup-gitleaks.ps1" >&2
  exit 0
fi

echo "[secret-scan] 扫描暂存区变更 ..."
"$GITLEAKS" git --staged --pre-commit --no-banner -v
STATUS=$?

if [ "$STATUS" -ne 0 ]; then
  echo "" >&2
  echo "[secret-scan] 检测到疑似敏感信息，提交已被阻止。" >&2
  echo "[secret-scan] 处理方式：" >&2
  echo "  - 误报：在该行末尾加  # gitleaks:allow" >&2
  echo "  - 需长期忽略：追加指纹到 .gitleaksignore（保留审计记录）" >&2
  echo "  - 真实泄露：从代码中移除并更换该凭据" >&2
  exit 1
fi

echo "[secret-scan] 未发现敏感信息，允许提交。"
exit 0
